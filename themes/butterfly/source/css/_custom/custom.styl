/*! 设定社交二维码弹窗的样式 */
.qr-modal
  display: none
  position: fixed
  inset: 0
  background: rgba(0,0,0,0.72)
  z-index: 9999
  align-items: center
  justify-content: center
  backdrop-filter: blur(4px)
.qr-modal.show
  display: flex
.qr-modal-inner
  position: relative
  background: #fff
  padding: 32px 28px
  border-radius: 16px
  text-align: center
  box-shadow: 0 8px 30px rgba(0,0,0,0.22)
  max-width: 320px
.qr-close
  position: absolute
  right: 16px
  top: 12px
  font-size: 26px
  cursor: pointer
  color: #888
  width: 32px
  height: 32px
  display flex
  align-items center
  justify-content center
  border-radius: 50%
  transition: all 0.2s ease
  &:hover
    background rgba(0,0,0,0.08)
    color: #222
#qr-title
  font-size: 16px
  margin: 0 0 16px
  color: #333
#qr-img
  width: 220px
  border-radius: 8px
// 适配Butterfly暗色模式
[data-theme="dark"]
  .qr-modal-inner
    background: #242424
  #qr-title
    color: #e5e5e5
  .qr-close
    color: #aaa
    &:hover
      background rgba(255,255,255,0.1)
      color: #fff